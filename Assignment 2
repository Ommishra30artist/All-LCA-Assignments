marks = float(input("Enter marks: "))

if marks >= 90 and marks <= 100:
    grade = "A++"
elif marks >= 80:
    grade = "A+"
elif marks >= 70:
    grade = "A"
elif marks >= 60:
    grade = "B"
elif marks >= 50:
    grade = "C"
elif marks >= 40:
    grade = "P"
elif marks >= 0:
    grade = "F"
else:
    grade = "Invalid Marks"

print("Grade:", grade)
