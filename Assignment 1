#Q.7
string = input("Enter a string: ")

frequency = {}

for char in string:
    if char.isalpha():
        char = char.lower()
        frequency[char] = frequency.get(char, 0) + 1

print("Frequency of letters:")

for char, count in frequency.items():
    print(char, ":", count)

